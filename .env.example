# --- Market data ---
# Alpaca by default. Massive's FREE tier is end-of-day only, so during a live
# session it returns yesterday's closes and every rule evaluates stale prices —
# use it only on a paid Massive tier.
DATA_PROVIDER=alpaca          # alpaca | massive
ALPACA_API_KEY=               # alpaca.markets -> Home -> API Keys (paper account is fine, no funding)
ALPACA_API_SECRET=
# ALPACA_FEED=iex             # iex = free real-time (one exchange, ~2.5% of volume); sip needs a paid plan
# MAX_STREAM_SYMBOLS=30       # free IEX websocket subscription ceiling

# Only used when DATA_PROVIDER=massive
# MASSIVE_API_KEY=
# MASSIVE_BASE_URL=https://api.massive.com

DRY_RUN=true                  # true = log notifications instead of actually sending
DASHBOARD_PORT=8000

# Alpaca's REST feed is real-time on IEX (~15s behind a bar close), so the
# default cron-driven shape alerts inside a minute with no symbol cap. Running
# the resident shape (Docker / systemd) additionally opens the websocket for ~5s
# alerts, but Alpaca caps a free websocket at 30 symbols. Seconds rarely matter.

# --- Email (Resend) ---
RESEND_API_KEY=               # your Resend API key
EMAIL_FROM=Alert Radar <alerts@liveradar.pro>      # must be an address on a Resend-verified domain
# OPS mail only — the MONITOR DOWN dead-man email. Alert emails go to each user's
# own recipient list (dashboard → Settings); they deliberately never fall back
# here, or a stranger's alerts would land in the operator's inbox.
DEFAULT_EMAIL_RECIPIENTS=     # comma-separated
# DEADMAN_SECONDS=300         # dead-man's-switch: warn if no successful cycle within this window

# --- Latency / alerting behaviour ---
# LIVE_PRICE=true             # evaluate against the live tape, not just closed bars.
#                             # Off => a move is invisible until its bar ends (up to
#                             # 15 min on a 15-min rule). On => caught within a cycle,
#                             # at the cost of alerts for moves that unwind by the close.
# ALERT_MIN_GAP_SECONDS=300   # floor between two alerts from one rule. Live evaluation
#                             # NEEDS this: a value oscillating around its threshold
#                             # crosses many times inside one bar. 0 = every edge fires.
# RULE_COOLDOWN_MINUTES=30    # re-alert this often while a condition STAYS true.
#                             # 0 = fire once on the edge and stay silent (old behaviour).
# BOUNDARY_ALIGN=true         # closed-bar mode only: sleep to the bar close before
#                             # evaluating, instead of reading a stale bar. Ignored
#                             # when LIVE_PRICE is on — there is no boundary to await.
# BAR_PUBLISH_LAG_SECONDS=18  # how long after a close the bar is served. MEASURE it:
#                             # python3 scripts/measure_publish_lag.py SPY 10
# MAX_ALIGN_SLEEP_SECONDS=40  # never hold an invocation open longer than this
# CLOSE_GRACE_SECONDS=120     # let the 16:00 bar evaluate; it publishes after the close
# DELIVERY_MAX_ATTEMPTS=5     # outbox: give up on an undeliverable alert after N tries
# DELIVERY_MAX_AGE_MINUTES=120

# --- Access control ---
# Sign-in is Google, via Supabase. FastAPI runs the OAuth code exchange server-side
# and mints its OWN httpOnly cookie, so no Supabase JWT ever reaches the browser
# (the dashboard loads a third-party CDN script and must not be able to read it).
# REQUIRED on any public deployment — the app refuses to serve unauthenticated,
# because an open /api/settings lets anyone redirect alerts to their own address.
SUPABASE_URL=                 # https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=            # the publishable key (sb_publishable_…); public by design
SESSION_SECRET=               # signs our session cookie — `openssl rand -hex 32`. Rotating it logs everyone out.
SITE_URL=                     # https://liveradar.pro — must match the Supabase redirect allow list exactly
CRON_SECRET=                  # a DIFFERENT secret; the scheduler sends it to /api/cron/evaluate
# ALLOWED_ORIGINS=            # comma-separated extra origins allowed to call the API
# MAX_RULES_PER_USER=25       # signup is open, and every distinct symbol×timeframe is a paid fetch

# Optional bearer-only escape hatch for curl/CLI/ops — NOT a browser login. It acts
# as OPERATOR_USER_ID, so set that to your own Supabase user id to reach your rules.
# ALERT_RADAR_TOKEN=          # e.g. `openssl rand -hex 32`
# OPERATOR_USER_ID=           # your auth.users.id uuid

# --- Persistence ---
# Unset  -> SQLite on local disk (dev, Docker).
# Set    -> PostgreSQL. Required on Vercel: the filesystem is read-only and every
#           request is a fresh process, so a local database cannot survive.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=require
# STATE_DIR=                  # where the SQLite file / log live (default: repo root)

# --- Local AI (optional, in-process via llama-cpp-python) ---
# Requires `pip install -r requirements-local.txt`. Automatically off on Vercel —
# the wheel and the ~1GB GGUF do not fit in a serverless function.
AI_ENABLED=true                                       # false to disable the NL rule builder + insights summary
# AI_MODEL_REPO=Qwen/Qwen2.5-1.5B-Instruct-GGUF       # 0.5B variant (Qwen/Qwen2.5-0.5B-Instruct-GGUF) is smaller/faster
# AI_MODEL_FILE=qwen2.5-1.5b-instruct-q4_k_m.gguf     # matched GGUF file in the repo above
