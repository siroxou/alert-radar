# --- Market data (Massive — formerly Polygon.io) ---
MASSIVE_API_KEY=              # your Massive API key (a paid plan is needed for real-time bars)
# MASSIVE_BASE_URL=https://api.massive.com   # override only if you need a non-default endpoint
DRY_RUN=true                  # true = log notifications instead of actually sending
DASHBOARD_PORT=8000

# --- Email (Resend) ---
RESEND_API_KEY=               # your Resend API key
EMAIL_FROM=Alert Radar <alerts@syncsolutions.ai>   # must be an address on a Resend-verified domain
DEFAULT_EMAIL_RECIPIENTS=     # fallback recipients, comma-separated (also editable in dashboard Settings)
# DEADMAN_SECONDS=300         # dead-man's-switch: warn if no successful cycle within this window
